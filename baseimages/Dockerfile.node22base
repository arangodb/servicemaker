FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

COPY ./scripts /scripts

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && /scripts/debinstall.sh \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm cache clean --force && \
    apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Patch npm's bundled dependencies without self-upgrading npm.
# Trivy full-image scans include /usr/lib/node_modules/npm/node_modules, so
# overrides on /home/user/package.json alone do not clear those findings.
RUN NPM_MODULES=/usr/lib/node_modules/npm/node_modules \
    && rm -rf "${NPM_MODULES}/picomatch" \
    && mkdir -p /tmp/picomatch \
    && curl -fsSL https://registry.npmjs.org/picomatch/-/picomatch-4.0.4.tgz -o /tmp/picomatch/picomatch.tgz \
    && tar -xzf /tmp/picomatch/picomatch.tgz -C /tmp/picomatch \
    && mv /tmp/picomatch/package "${NPM_MODULES}/picomatch" \
    && rm -rf /tmp/picomatch \
    && mkdir -p /tmp/npm-dep-patch \
    && cd /tmp/npm-dep-patch \
    && npm init -y >/dev/null 2>&1 \
    && npm install \
        sigstore@4.1.1 \
        tar@7.5.19 \
        brace-expansion@2.1.2 \
        --omit=dev --no-package-lock \
    && rm -rf "${NPM_MODULES}/sigstore" "${NPM_MODULES}/@sigstore" \
    && cp -r node_modules/sigstore "${NPM_MODULES}/" \
    && cp -r node_modules/@sigstore "${NPM_MODULES}/" \
    && mkdir -p "${NPM_MODULES}/@gar" \
    && ([ -d node_modules/@gar ] && cp -r node_modules/@gar/. "${NPM_MODULES}/@gar/" || true) \
    && rm -rf "${NPM_MODULES}/tar" "${NPM_MODULES}/brace-expansion" \
        "${NPM_MODULES}/chownr" "${NPM_MODULES}/yallist" \
        "${NPM_MODULES}/minipass" "${NPM_MODULES}/minizlib" \
        "${NPM_MODULES}/balanced-match" \
    && cp -r node_modules/tar "${NPM_MODULES}/" \
    && cp -r node_modules/brace-expansion "${NPM_MODULES}/" \
    && cp -r node_modules/chownr "${NPM_MODULES}/" \
    && cp -r node_modules/yallist "${NPM_MODULES}/" \
    && cp -r node_modules/minipass "${NPM_MODULES}/" \
    && cp -r node_modules/minizlib "${NPM_MODULES}/" \
    && cp -r node_modules/balanced-match "${NPM_MODULES}/" \
    && mkdir -p "${NPM_MODULES}/@isaacs" \
    && ([ -d node_modules/@isaacs ] && cp -r node_modules/@isaacs/. "${NPM_MODULES}/@isaacs/" || true) \
    && rm -rf /tmp/npm-dep-patch

WORKDIR /home/user
USER user

RUN npm init -y

# Apply security overrides to fix vulnerabilities
RUN npm pkg set "overrides.path-to-regexp=0.1.13" && \
    npm pkg set "overrides.tar=7.5.19" && \
    npm pkg set "overrides.brace-expansion=2.1.2" && \
    npm pkg set "overrides.body-parser=1.20.3" && \
    npm pkg set "overrides.form-data=4.0.6" && \
    npm pkg set "overrides.sigstore=4.1.1"

# Create base node_modules with standard packages (immutable, pre-scanned)
# This location is used by all projects and should never be modified
# Standard packages are selected to benefit most projects while keeping image size reasonable
RUN npm install \
    express@4.18.2 \
    arangojs@10.2.2 \
    # Dependency checking utility
    semver@7.6.3 \
    # Essential utilities
    dayjs@1.11.10 \
    uuid@9.0.1 \
    dotenv@16.4.5 \
    # HTTP clients
    axios@1.18.0 \
    # Validation
    joi@17.13.3 \
    # Logging
    winston@3.15.0 \
    # Async utilities
    async@3.2.5 \
    # Security
    jsonwebtoken@9.0.2 \
    bcrypt@5.1.1 \
    --omit=dev --legacy-peer-deps

# Create checksums for base node_modules (for tracking, base remains immutable)
RUN find node_modules -type f -print0 | \
    xargs -0 sha256sum > sums_sha256

CMD [ "/scripts/entrypoint.sh" ]
